{deps, [
    erldist_filter,
    % OTP 29 warning fixes are not yet available in a Hex release.
    {proper, {git, "https://github.com/proper-testing/proper.git", {ref, "21de022438cb57a04cbcf0f3e5b40bb846598daa"}}}
